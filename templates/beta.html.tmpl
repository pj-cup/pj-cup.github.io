<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<meta name="robots" content="noindex">
<title>$title · Beta</title>
<meta name="description" content="$description">
<meta property="og:type" content="website">
<meta property="og:title" content="$title · Beta">
<meta property="og:description" content="$description">
<meta property="og:url" content="$page_url">
<meta property="og:image" content="$image_url">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="$title · Beta">
<meta name="twitter:description" content="$description">
<meta name="twitter:image" content="$image_url">
<link rel="icon" href="logo.png" type="image/png">
<script>
(function () {
  var r = document.documentElement;
  r.classList.add("js");
  // If beta.js never boots (blocked, failed, syntax error), fall back to the static page.
  setTimeout(function () {
    if (!r.hasAttribute("data-boot")) r.classList.remove("js");
  }, 4000);
})();
</script>
<link rel="stylesheet" href="beta.css">
</head>
<body>
<div class="balls" aria-hidden="true"></div>
<canvas id="fx" aria-hidden="true"></canvas>

<div id="splash" class="splash" aria-hidden="true">
  <div class="splash-stage">
    <svg class="court" viewBox="0 0 260 120" focusable="false">
      <rect class="surface" x="10" y="5" width="240" height="110" rx="2"/>
      <path class="ln" style="--i:0" pathLength="1" d="M10 5H250V115H10Z"/>
      <path class="ln" style="--i:1" pathLength="1" d="M10 18.75H250"/>
      <path class="ln" style="--i:2" pathLength="1" d="M10 101.25H250"/>
      <path class="ln" style="--i:3" pathLength="1" d="M65.4 18.75V101.25"/>
      <path class="ln" style="--i:4" pathLength="1" d="M194.6 18.75V101.25"/>
      <path class="ln" style="--i:5" pathLength="1" d="M65.4 60H194.6"/>
      <path class="ln net" style="--i:6" pathLength="1" d="M130 0V120"/>
    </svg>
  </div>
  <div class="sball"><span class="shadow"></span><i class="bounce"><i class="tball" style="font-size:34px"></i></i></div>
  <div class="splash-title">$title_letters</div>
  <div class="skip">TAP TO SKIP</div>
</div>

<div class="container">
  <header class="site-header">
    <div class="site-title">
      <img src="logo.png" alt="" class="logo" width="48" height="48">
      <div>
        <h1>$title</h1>
        <p class="subtitle">Snapshot: $snapshot_date</p>
      </div>
    </div>
    <a class="classic" href="index.html">&larr; Classic view</a>
  </header>

  <section id="standings" class="reveal">
    <h2>Standings</h2>
$standings_note$standings_board
  </section>
$rules_section
  <section id="h2h" class="reveal">
    <h2>Head-to-Head</h2>
    <div class="table-scroll">
$h2h_table
    </div>
  </section>

  <footer>
    <p class="source">Source: $source_file</p>
  </footer>
</div>
<script src="beta.js"></script>
</body>
</html>
