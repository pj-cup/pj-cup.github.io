:root {
  --bg: #f7fbf5;
  --fg: #142b1c;
  --muted: #5c7061;
  --border: #cfe6d2;
  --stripe: #eaf6ea;
  --accent-soft: #dcf2dd;
  --accent: #1c7a3e;
  --warn: #b45309;
  --down: #c0392b;
  --card-bg: #12233d;
  --card-line: rgba(255, 255, 255, 0.1);
  --card-fg: #f2f6fb;
  --card-muted: #9fb0c8;
  --card-tile: rgba(255, 255, 255, 0.07);
  --card-win: #34d27b;
  --card-draw: #f0b429;
  --card-loss: #f0625f;
  --radar-area: rgba(58, 98, 150, 0.45);
  --radar-grid: rgba(160, 190, 230, 0.55);
  --radar-fill: rgba(200, 230, 60, 0.55);
  --radar-accent: #e4f53b;
  --cmp-a-fill: rgba(200, 230, 60, 0.35);
  --cmp-b: #4cc9f0;
  --cmp-b-fill: rgba(76, 201, 240, 0.35);
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0c1710;
    --fg: #e3f2e5;
    --muted: #8fab97;
    --border: #1f3d28;
    --stripe: #122419;
    --accent-soft: #16341f;
    --accent: #4fd07d;
    --warn: #f0a848;
    --down: #ff7b6b;
    --card-bg: #0e1b30;
    --card-line: rgba(160, 190, 230, 0.22);
  }
}

:root[data-theme="dark"] {
  --bg: #0c1710;
  --fg: #e3f2e5;
  --muted: #8fab97;
  --border: #1f3d28;
  --stripe: #122419;
  --accent-soft: #16341f;
  --accent: #4fd07d;
  --warn: #f0a848;
  --down: #ff7b6b;
  --card-bg: #0e1b30;
  --card-line: rgba(160, 190, 230, 0.22);
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--fg);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial,
    Thonburi, "Noto Sans Thai", "Leelawadee UI", sans-serif;
}

.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 1.5rem 1rem 3rem;
}

.site-header {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 0.75rem 1rem;
  padding-bottom: 1rem;
  border-bottom: 3px solid var(--accent);
}

.site-title {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.logo {
  flex: none;
  width: 40px;
  height: 40px;
  border-radius: 8px;
  background: #ffffff;
  object-fit: contain;
}

header h1 {
  margin: 0 0 0.25rem;
  font-size: 1.75rem;
}

header .subtitle {
  margin: 0;
  color: var(--muted);
  font-size: 0.95rem;
}

.header-actions {
  flex: none;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.lang-toggle {
  display: inline-flex;
  border: 1px solid var(--border);
  border-radius: 999px;
  overflow: hidden;
  font-size: 0.8rem;
  font-weight: 600;
}

.lang-toggle a,
.lang-toggle span {
  padding: 0.45rem 0.65rem;
  line-height: 1;
}

.lang-toggle a {
  color: var(--muted);
  text-decoration: none;
}

.lang-toggle a:hover {
  background: var(--accent-soft);
}

.lang-toggle span {
  background: var(--accent);
  color: var(--bg);
}

.theme-toggle {
  flex: none;
  width: 2.25rem;
  height: 2.25rem;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--stripe);
  color: var(--fg);
  font-size: 1.05rem;
  line-height: 1;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.theme-toggle:hover {
  background: var(--accent-soft);
}

section {
  margin-top: 2rem;
}

section h2 {
  font-size: 1.15rem;
  margin-bottom: 0.75rem;
}

.table-scroll {
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: 8px;
}

table {
  border-collapse: collapse;
  width: 100%;
  font-size: 0.88rem;
  white-space: nowrap;
}

th, td {
  padding: 0.5rem 0.75rem;
  text-align: left;
  border-bottom: 1px solid var(--border);
}

thead th {
  background: var(--stripe);
  font-weight: 600;
}

tbody tr:nth-child(even) {
  background: var(--stripe);
}

tbody tr:hover > td,
tbody tr:hover > th {
  background: var(--accent-soft);
}

td.num, th.num {
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.standings-note {
  margin: -0.4rem 0 0.75rem;
  color: var(--muted);
  font-size: 0.8rem;
}

.league-progress {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin: 0 0 0.75rem;
  color: var(--muted);
  font-size: 0.8rem;
}

.latest-list {
  list-style: none;
  margin: 0 0 0.6rem;
  padding: 0;
  max-width: 32rem;
}

.latest-list li {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.45rem 0;
  border-bottom: 1px solid var(--border);
}

.latest-list li:last-child {
  border-bottom: 0;
}

.latest-list .who {
  flex: 1;
  font-weight: 600;
}

.latest-list .who:last-child {
  text-align: right;
}

.latest-list .score {
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.latest-list em {
  color: var(--muted);
  font-size: 0.75rem;
}

.latest-none,
.latest-moves {
  margin: 0 0 0.6rem;
  color: var(--muted);
  font-size: 0.85rem;
}

.latest-moves .rank-move {
  margin-left: 0.15rem;
}

.rank-chart svg {
  display: block;
  width: 100%;
  max-width: 40rem;
  height: auto;
}

.rc-grid { stroke: var(--border); stroke-dasharray: 3 4; }
.rc-date { fill: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
.rank-chart .player-link { border-bottom: 0; }
.rc-player { transition: opacity 0.15s; }
.rc-hit { fill: none; stroke: transparent; stroke-width: 14; stroke-linecap: round; }
.rc-line { fill: none; stroke: var(--muted); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
.rc-dot { fill: var(--bg); stroke: var(--muted); stroke-width: 2; }
.rc-name { fill: var(--fg); font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums; }

.rank-chart svg:hover .rc-player,
.rank-chart svg:focus-within .rc-player { opacity: 0.25; }
.rank-chart svg .rc-player:hover,
.rank-chart svg .rc-player:focus { opacity: 1; outline: none; }
.rc-player:hover .rc-line,
.rc-player:focus .rc-line { stroke: var(--accent); stroke-width: 3; }
.rc-player:hover .rc-dot,
.rc-player:focus .rc-dot { fill: var(--accent); stroke: var(--accent); }
.rc-player:hover .rc-name,
.rc-player:focus .rc-name { fill: var(--accent); font-weight: 800; }

@media (prefers-reduced-motion: reduce) {
  .rc-player { transition: none; }
}

.lp-bar {
  flex: 1;
  max-width: 12rem;
  height: 6px;
  border-radius: 3px;
  background: var(--border);
  overflow: hidden;
}

.lp-bar > i {
  display: block;
  height: 100%;
  background: var(--accent);
}

.rank-move {
  margin-left: 0.35rem;
  font-size: 0.72rem;
  font-weight: 600;
  white-space: nowrap;
  cursor: help;
}

.rank-move.up { color: var(--accent); }
.rank-move.down { color: var(--down); }
.rank-move.same { color: var(--muted); font-weight: 400; }

.badge {
  display: inline-block;
  padding: 0.15rem 0.55rem;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 0.8rem;
  white-space: nowrap;
}

.rules-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 0.75rem;
}

.rules-list li {
  display: flex;
  align-items: center;
}

/* head-to-head grid */
.h2h thead th:first-child,
.h2h tbody th {
  position: sticky;
  left: 0;
  z-index: 2;
  background: var(--bg);
  text-align: left;
  font-weight: 600;
}

.h2h thead th {
  position: sticky;
  top: 0;
  z-index: 1;
  background: var(--stripe);
}

.h2h thead th:first-child {
  z-index: 3;
}

.h2h td {
  text-align: center;
}

.cell-empty {}

.cell-tba {
  color: var(--muted);
  font-style: italic;
}

.cell-ongoing {
  color: var(--warn);
  font-style: italic;
}

.cell-ongoing::after {
  content: " \25CF";
  font-size: 0.6em;
  vertical-align: middle;
}

.cell-diag {
  background-image: repeating-linear-gradient(
    45deg,
    var(--border),
    var(--border) 2px,
    transparent 2px,
    transparent 7px
  );
}

.cell-result {
  font-variant-numeric: tabular-nums;
}

footer {
  margin-top: 2.5rem;
}

.source {
  color: var(--muted);
  font-size: 0.8rem;
}

/* player names open a card */
.player-link {
  color: inherit;
  text-decoration: none;
  border-bottom: 1px dotted var(--muted);
  cursor: pointer;
}

.player-link:hover,
.player-link:focus-visible {
  color: var(--accent);
  border-bottom-color: var(--accent);
}

/* player card (always the dark "broadcast" style, in both themes) */
dialog.player-card {
  width: min(440px, calc(100vw - 2rem));
  max-height: calc(100vh - 2rem);
  max-height: calc(100dvh - 2rem);
  padding: 0;
  border: 1px solid var(--card-line);
  border-radius: 18px;
  background: linear-gradient(180deg, var(--card-bg), #0a1424);
  color: var(--card-fg);
  overflow-y: auto;
  overscroll-behavior: contain;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
}

dialog.player-card:focus {
  outline: none;
}

dialog.player-card::backdrop {
  background: rgba(4, 10, 20, 0.6);
  -webkit-backdrop-filter: blur(3px);
  backdrop-filter: blur(3px);
}

/* no-JS fallback: #player-x deep links still show the card */
html:not(.pc-js) dialog.player-card:target {
  display: block;
  position: fixed;
  inset: 1rem;
  margin: auto;
  z-index: 10;
}

.pc-inner {
  padding: 1.1rem 1.1rem 1.25rem;
}

.pc-head {
  display: flex;
  align-items: center;
  gap: 0.8rem;
}

.pc-rank {
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.6rem;
  height: 2.6rem;
  border-radius: 999px;
  background: var(--radar-accent);
  color: #0a1424;
  font-size: 1.15rem;
  font-weight: 800;
}

.pc-id {
  flex: 1;
  min-width: 0;
}

.pc-id h3 {
  margin: 0;
  font-size: 1.6rem;
  line-height: 1.1;
  overflow-wrap: anywhere;
}

.pc-record {
  margin: 0.2rem 0 0;
  color: var(--card-muted);
  font-size: 0.85rem;
}

.player-card .rank-move.up { color: var(--card-win); }
.player-card .rank-move.down { color: var(--card-loss); }
.player-card .rank-move.same { color: var(--card-muted); }

.pc-close {
  flex: none;
  align-self: flex-start;
  width: 2rem;
  height: 2rem;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--card-muted);
  text-decoration: none;
  font-size: 1.5rem;
  line-height: 1;
}

.pc-head .lang-toggle {
  flex: none;
  align-self: flex-start;
  border-color: var(--card-line);
}

.pc-head .lang-toggle a { color: var(--card-muted); }
.pc-head .lang-toggle a:hover { background: var(--card-tile); }

.pc-head .lang-toggle span {
  background: var(--radar-accent);
  color: #0a1424;
}

.pc-close:hover,
.pc-close:focus-visible {
  background: var(--card-tile);
  color: var(--card-fg);
}

.pc-tiles {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.45rem;
  margin-top: 1rem;
}

.pc-tile {
  padding: 0.45rem 0.55rem;
  border-radius: 10px;
  background: var(--card-tile);
}

.pc-tile span {
  display: block;
  color: var(--card-muted);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pc-tile b {
  display: block;
  font-size: 1.15rem;
  font-variant-numeric: tabular-nums;
}

.pc-tiles.small {
  margin-top: 0.5rem;
}

.pc-tiles.small .pc-tile b {
  font-size: 1rem;
}

.pc-block {
  margin-top: 1.2rem;
}

.pc-block h4 {
  margin: 0;
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--card-muted);
}

.pc-insights {
  text-align: center;
}

.pc-insights h4 {
  color: var(--card-fg);
  font-size: 1rem;
  font-weight: 800;
}

.pc-sub {
  margin: 0.15rem 0 0;
  color: var(--card-muted);
  font-size: 0.72rem;
}

.radar {
  display: block;
  width: 100%;
  height: auto;
  margin-top: 0.25rem;
}

.rg-area { fill: var(--radar-area); }
.rg-ring { fill: none; stroke: var(--radar-grid); stroke-opacity: 0.35; }
.rg-spoke { stroke: var(--radar-grid); }
.rg-outer { fill: none; stroke: var(--radar-grid); stroke-width: 1.5; stroke-dasharray: 5 4; }
.rg-dot { fill: var(--radar-grid); }

.rg-shape {
  fill: var(--radar-fill);
  stroke: var(--radar-accent);
  stroke-width: 3.5;
  stroke-linejoin: round;
  transform-box: view-box;
  transform-origin: 190px 180px;
}

.rg-label {
  fill: var(--card-fg);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.rg-value {
  fill: var(--card-fg);
  font-size: 26px;
  font-weight: 800;
}

.rg-label.top,
.rg-value.top {
  fill: var(--radar-accent);
}

.rank-history {
  display: block;
  width: 100%;
  max-width: 26rem;
  height: auto;
  margin-top: 0.5rem;
}

.rh-grid { stroke: var(--card-line); stroke-dasharray: 4 4; }
.rh-line { fill: none; stroke: var(--radar-accent); stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; }
.rh-dot { fill: var(--card-bg); stroke: var(--radar-accent); stroke-width: 2; }
.rh-dot.now { fill: var(--radar-accent); }
.rh-label { fill: var(--card-muted); font-size: 11px; font-variant-numeric: tabular-nums; }
.rh-now { fill: var(--radar-accent); font-size: 13px; font-weight: 800; }

.pc-results {
  list-style: none;
  margin: 0.5rem 0 0;
  padding: 0;
  font-size: 0.88rem;
}

.pc-results li {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.4rem 0;
  border-bottom: 1px solid var(--card-line);
}

.pc-results li:last-child {
  border-bottom: 0;
}

.pc-results .opp {
  flex: 1;
  font-weight: 600;
}

.pc-results .score {
  color: var(--card-muted);
  font-variant-numeric: tabular-nums;
}

.pc-remaining {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  list-style: none;
  margin: 0.5rem 0 0;
  padding: 0;
}

.pc-remaining li {
  padding: 0.25rem 0.6rem;
  border-radius: 999px;
  background: var(--card-tile);
  font-size: 0.82rem;
  font-weight: 600;
}

.pc-remaining li.tba {
  outline: 1px dashed var(--card-muted);
  outline-offset: -1px;
}

.pc-remaining li.ongoing {
  box-shadow: inset 0 0 0 1px var(--card-draw);
}

.pc-remaining .player-link {
  color: var(--card-fg);
}

.pc-results em {
  font-size: 0.75rem;
}

.chip {
  flex: none;
  width: 1.5rem;
  height: 1.5rem;
  border-radius: 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  font-weight: 800;
  color: #0a1424;
  background: var(--card-muted);
}

.chip.win { background: var(--card-win); }
.chip.draw { background: var(--card-draw); }
.chip.loss { background: var(--card-loss); }
.chip.live { background: transparent; color: var(--card-draw); border: 1px dashed var(--card-draw); }

.pc-empty {
  margin: 0.5rem 0 0;
  color: var(--card-muted);
  font-size: 0.85rem;
}

.pc-actions {
  margin-top: 1.2rem;
}

.pc-share {
  width: 100%;
  padding: 0.7rem 1rem;
  border: 0;
  border-radius: 12px;
  background: var(--radar-accent);
  color: #0a1424;
  font: inherit;
  font-weight: 800;
  cursor: pointer;
}

.pc-share:disabled {
  opacity: 0.6;
  cursor: progress;
}

.pc-share[hidden] {
  display: none;
}

/* player compare (one dialog, filled in by player-card.js) */
.pc-compare {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 0.6rem;
  color: var(--card-muted);
  font-size: 0.85rem;
  font-weight: 600;
}

.pc-compare[hidden] {
  display: none;
}

.pc-compare select {
  flex: 1;
  min-width: 0;
  padding: 0.55rem 0.7rem;
  border: 1px solid var(--card-line);
  border-radius: 10px;
  background: var(--card-tile);
  color: var(--card-fg);
  font: inherit;
  font-weight: 700;
}

.pc-compare select option {
  background: var(--card-bg);
  color: var(--card-fg);
}

.cmp-title {
  flex: 1;
  margin: 0;
  color: var(--card-muted);
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.cmp-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: start;
  gap: 0.5rem;
  margin-top: 0.6rem;
}

.cmp-side .player-link {
  display: block;
  margin-top: 0.4rem;
  border-bottom: 0;
  font-size: 1.35rem;
  font-weight: 800;
  line-height: 1.1;
  overflow-wrap: anywhere;
}

.cmp-side.a .player-link { color: var(--radar-accent); }
.cmp-side.b { text-align: right; }
.cmp-side.b .player-link { color: var(--cmp-b); }
.cmp-side.b .pc-rank { background: var(--cmp-b); }

.cmp-side .pc-rank {
  width: 2.1rem;
  height: 2.1rem;
  font-size: 0.95rem;
}

.cmp-vs {
  align-self: center;
  color: var(--card-muted);
  font-weight: 800;
}

.cmp-h2h {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin: 0.5rem 0 0;
  font-weight: 700;
}

.cmp-rows {
  display: grid;
  gap: 0.15rem;
}

.cmp-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: 0.5rem;
  padding: 0.3rem 0.6rem;
  border-radius: 8px;
  font-variant-numeric: tabular-nums;
}

.cmp-row:nth-child(odd) {
  background: var(--card-tile);
}

.cmp-row span {
  color: var(--card-muted);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-align: center;
}

.cmp-row b {
  font-weight: 600;
}

.cmp-row b.b {
  text-align: right;
}

.cmp-row b.better {
  font-weight: 800;
}

.cmp-row b.a.better { color: var(--radar-accent); }
.cmp-row b.b.better { color: var(--cmp-b); }

.rg-shape.a {
  fill: var(--cmp-a-fill);
}

.rg-shape.b {
  fill: var(--cmp-b-fill);
  stroke: var(--cmp-b);
}

.rg-value.cmp {
  font-size: 18px;
}

.rg-value.cmp .a { fill: var(--radar-accent); }
.rg-value.cmp .b { fill: var(--cmp-b); }
.rg-value.cmp .sep { fill: var(--card-muted); }

@media (prefers-reduced-motion: no-preference) {
  dialog.player-card[open] .rg-shape {
    animation: radar-grow 0.6s cubic-bezier(0.2, 0.9, 0.3, 1.2);
  }
}

@keyframes radar-grow {
  from { transform: scale(0); }
  to { transform: scale(1); }
}

@media (max-width: 480px) {
  header h1 { font-size: 1.4rem; }
}

@media (max-width: 400px) {
  .pc-inner { padding: 0.9rem 0.8rem 1rem; }
  .pc-tile { padding: 0.4rem 0.45rem; }
  .pc-tile b { font-size: 1rem; }
}

@media print {
  dialog.player-card { display: none !important; }
}

/* Thai: no tracking or caps on the small uppercase labels (it pulls tone marks apart). */
:lang(th) :is(.pc-tile span, .pc-block h4, .rg-label, .cmp-title, .cmp-row span) {
  letter-spacing: 0;
  text-transform: none;
}
