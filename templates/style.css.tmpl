:root {
  --bg: #f7fbf5;
  --fg: #142b1c;
  --muted: #5c7061;
  --border: #cfe6d2;
  --stripe: #eaf6ea;
  --accent-soft: #dcf2dd;
  --accent: #1c7a3e;
  --warn: #b45309;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0c1710;
    --fg: #e3f2e5;
    --muted: #8fab97;
    --border: #1f3d28;
    --stripe: #122419;
    --accent-soft: #16341f;
    --accent: #4fd07d;
    --warn: #f0a848;
  }
}

:root[data-theme="dark"] {
  --bg: #0c1710;
  --fg: #e3f2e5;
  --muted: #8fab97;
  --border: #1f3d28;
  --stripe: #122419;
  --accent-soft: #16341f;
  --accent: #4fd07d;
  --warn: #f0a848;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--fg);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 1.5rem 1rem 3rem;
}

.site-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  padding-bottom: 1rem;
  border-bottom: 3px solid var(--accent);
}

.site-title {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.logo {
  flex: none;
  width: 40px;
  height: 40px;
  border-radius: 8px;
  background: #ffffff;
  object-fit: contain;
}

header h1 {
  margin: 0 0 0.25rem;
  font-size: 1.75rem;
}

header .subtitle {
  margin: 0;
  color: var(--muted);
  font-size: 0.95rem;
}

.theme-toggle {
  flex: none;
  width: 2.25rem;
  height: 2.25rem;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--stripe);
  color: var(--fg);
  font-size: 1.05rem;
  line-height: 1;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.theme-toggle:hover {
  background: var(--accent-soft);
}

section {
  margin-top: 2rem;
}

section h2 {
  font-size: 1.15rem;
  margin-bottom: 0.75rem;
}

.table-scroll {
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: 8px;
}

table {
  border-collapse: collapse;
  width: 100%;
  font-size: 0.88rem;
  white-space: nowrap;
}

th, td {
  padding: 0.5rem 0.75rem;
  text-align: left;
  border-bottom: 1px solid var(--border);
}

thead th {
  background: var(--stripe);
  font-weight: 600;
}

tbody tr:nth-child(even) {
  background: var(--stripe);
}

tbody tr:hover > td,
tbody tr:hover > th {
  background: var(--accent-soft);
}

td.num, th.num {
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.badge {
  display: inline-block;
  padding: 0.15rem 0.55rem;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 0.8rem;
  white-space: nowrap;
}

.rules-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 0.75rem;
}

.rules-list li {
  display: flex;
  align-items: center;
}

/* head-to-head grid */
.h2h thead th:first-child,
.h2h tbody th {
  position: sticky;
  left: 0;
  z-index: 2;
  background: var(--bg);
  text-align: left;
  font-weight: 600;
}

.h2h thead th {
  position: sticky;
  top: 0;
  z-index: 1;
  background: var(--stripe);
}

.h2h thead th:first-child {
  z-index: 3;
}

.h2h td {
  text-align: center;
}

.cell-empty {}

.cell-tba {
  color: var(--muted);
  font-style: italic;
}

.cell-ongoing {
  color: var(--warn);
  font-style: italic;
}

.cell-ongoing::after {
  content: " \25CF";
  font-size: 0.6em;
  vertical-align: middle;
}

.cell-diag {
  background-image: repeating-linear-gradient(
    45deg,
    var(--border),
    var(--border) 2px,
    transparent 2px,
    transparent 7px
  );
}

.cell-result {
  font-variant-numeric: tabular-nums;
}

footer {
  margin-top: 2.5rem;
}

.source {
  color: var(--muted);
  font-size: 0.8rem;
}
