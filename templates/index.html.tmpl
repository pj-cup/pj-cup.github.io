<!doctype html>
<html lang="$lang">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$title</title>
<meta name="description" content="$description">
<meta property="og:type" content="website">
<meta property="og:title" content="$title">
<meta property="og:description" content="$description">
<meta property="og:url" content="$page_url">
<meta property="og:locale" content="$og_locale">
<meta property="og:image" content="$image_url">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="$title">
<meta name="twitter:description" content="$description">
<meta name="twitter:image" content="$image_url">
<link rel="icon" href="logo.png" type="image/png">
$alt_links
<script>
(function () {
  try {
    var stored = localStorage.getItem("theme");
    if (stored === "light" || stored === "dark") {
      document.documentElement.setAttribute("data-theme", stored);
    }
  } catch (e) {}
})();
</script>
<link rel="stylesheet" href="style.css">
</head>
<body>
<div class="container">
  <header class="site-header">
    <div class="site-title">
      <img src="logo.png" alt="" class="logo" width="40" height="40">
      <div>
        <h1>$title</h1>
        <p class="subtitle">$l_snapshot</p>
      </div>
    </div>
    <div class="header-actions">
      $lang_toggle
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="$l_theme_toggle">🌙</button>
    </div>
  </header>

$latest_results  <section>
    <h2>$l_standings</h2>
$standings_note$league_progress    <div class="table-scroll">
$standings_table
    </div>
  </section>
$rank_chart  <section>
    <h2>$l_h2h</h2>
    <div class="table-scroll">
$h2h_table
    </div>
  </section>
$rules_section
  <footer>
    <p class="source">$l_source</p>
  </footer>
</div>
$player_cards
$compare
$match_dialog
<script src="theme.js"></script>
<script src="player-card.js"></script>
</body>
</html>
